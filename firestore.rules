rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Default deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    // Users collection and subcollections
    match /users/{userId} {
      allow get: if isOwner(userId);
      allow create, update: if isOwner(userId) && isValidId(userId);
      allow delete: if false;

      // Photos subcollection
      match /photos/{photoId} {
        allow get, list: if isOwner(userId);
        allow create, update: if isOwner(userId) && isValidId(photoId);
        allow delete: if isOwner(userId);
      }

      // Settings subcollection
      match /settings/{settingId} {
        allow get, list: if isOwner(userId);
        allow create, update: if isOwner(userId) && isValidId(settingId);
        allow delete: if isOwner(userId);
      }
    }
  }
}
